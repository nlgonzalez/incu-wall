# Copiar a .env (o .env.local) y completar. Nunca commitear valores reales.

# URL del proyecto Supabase (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (pública por diseño; con RLS sin políticas no puede leer tablas)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — SOLO servidor; nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Password de la base Postgres — solo para aplicar migraciones con la CLI
SUPABASEPASSWORD=

# Opcional: si se define, crear un tablero en / exige esta password
BOARD_CREATION_PASSWORD=
